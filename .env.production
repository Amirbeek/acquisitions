# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Neon Cloud Database URL (replace with your actual Neon Cloud URL)
DATABASE_URL=postgres://your-username:your-password@ep-example-pooler.us-east-1.neon.tech/neondb?sslmode=require

# Application Secrets (inject via environment variables in deployment)
JWT_SECRET=${JWT_SECRET}
BCRYPT_ROUNDS=12

# Production specific settings
LOG_LEVEL=info

# Optional: Additional production configurations
TRUST_PROXY=true