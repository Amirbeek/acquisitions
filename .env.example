# Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in your values

# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
# For development (using Neon Local):
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=require

# For production (using Neon Cloud):
# DATABASE_URL=postgres://your-username:your-password@ep-example-pooler.us-east-1.neon.tech/neondb?sslmode=require

# Neon API Configuration (required for Neon Local)
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=your_parent_branch_id_here

# Application Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Additional Production Settings (optional)
TRUST_PROXY=true

# Instructions:
# 1. Get your Neon API key from: https://console.neon.tech/app/settings/api-keys
# 2. Find your Project ID in your Neon dashboard URL or project settings
# 3. Get your Parent Branch ID (usually 'main' or the default branch) from your Neon project
# 4. For production, replace DATABASE_URL with your actual Neon Cloud connection string
# 5. Generate a strong JWT secret for production use